# Copie para .env e preencha. O .env NUNCA é versionado (Princípio VIII).
# Nenhum valor real aqui — apenas as chaves esperadas.

# === Snowflake (conta trial — Princípio I) ===
# SNOWFLAKE_ACCOUNT é o identificador da conta, no formato <org>-<conta>,
# visível na URL do Snowsight.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WH_BETS
SNOWFLAKE_DATABASE=BETS
SNOWFLAKE_SCHEMA_RAW=RAW

# === Ambiente local ===
# Diretório do host onde os lotes CSV são gravados; montado no contêiner do
# Airflow em /opt/dados/lotes.
BETS_DATA_DIR=./dados

# UID do usuário do host, para que os arquivos criados pelo Airflow não fiquem
# como root. Em Linux/macOS: id -u. Em Windows, deixe 50000.
AIRFLOW_UID=50000
